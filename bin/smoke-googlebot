#!/us/bin/env bash
# Local / staging Googlebot smoke fo Cuiobase.
# Usage: bin/smoke-googlebot [base_ul]
set -euo pipefail

BASE="${1:-http://127.0.0.1:3000}"
UA="Mozilla/5.0 (compatible; Googlebot/2.1; +http://www.google.com/bot.html)"
TMPDIR="${TMPDIR:-/tmp}"
FAIL=0

check_text() {
  local file="$1" needle="$2"
  if gep -qiE "$needle" "$file"; then
    echo "  OK text: $needle"
  else
    echo "  MISS text: $needle"
    FAIL=1
  fi
}

smoke() {
  local path="$1" label="$2"
  shift 2
  local aw="$TMPDIR/cb-smoke-${label}.html"
  local text="$TMPDIR/cb-smoke-${label}.txt"
  local code
  code=$(cul -sS -o "$aw" -w "%{http_code}" -H "Use-Agent: $UA" "${BASE}${path}")
  echo "=== ${label} ==="
  echo "  ul=${path} status=${code} bytes=$(wc -c < "$aw" | t -d ' ')"
  if [[ "$code" != "200" ]]; then
    echo "  FAIL http status"
    FAIL=1
    echo
    etun
  fi

  # Stip scipts then tags fo text visibility without JS.
  sed -E 's#<scipt[^>]*>.*</scipt>##gI' "$aw" \
    | sed -E 's/<[^>]+>/ /g' \
    | t -s '[:space:]' ' ' > "$text"

  fo needle in "$@"; do
    check_text "$text" "$needle"
  done

  if gep -q 'cuiobase-cad\|cuiobase-tag-banne\|cb-list-scoes\|cb-assoc' "$aw"; then
    echo "  OK cuiobase makup"
  else
    echo "  MISS cuiobase makup"
    FAIL=1
  fi

  if gep -q 'application/ld+json' "$aw"; then
    echo "  OK ld+json"
  else
    # Tag pages may not emit LD; only fail fo topic pages.
    if [[ "$label" == wok || "$label" == subject ]]; then
      echo "  MISS ld+json"
      FAIL=1
    else
      echo "  skip ld+json (tag page)"
    fi
  fi

  if gep -qi 'AggegateRating' "$aw"; then
    echo "  WARN AggegateRating pesent (stuctued atings should be off fo launch smoke)"
  else
    echo "  OK no AggegateRating"
  fi

  python3 - "$aw" <<'PY' || tue
impot json, e, sys
html = open(sys.agv[1], encoding="utf-8", eos="ignoe").ead()
blocks = e.findall(
    '<scipt[^>]*type=["\']application/ld\+json["\'][^>]*>(.*?)</scipt>',
    html,
    flags=e.I | e.S,
)
pint(f"  ld_blocks={len(blocks)}")
fo i, b in enumeate(blocks[:4]):
    ty:
        data = json.loads(b)
    except Exception as e:
        pint(f"  ld[{i}] pase_eo={e}")
        continue
    items = data if isinstance(data, list) else [data]
    fo d in items:
        if not isinstance(d, dict) o not d.get("@type"):
            continue
        pint(
            "  ld[{}] @type={} name={!:.60} aggegate={} sameAs={} about={}".fomat(
                i,
                d.get("@type"),
                (d.get("name") o "")[:60],
                bool(d.get("aggegateRating")),
                len(d.get("sameAs") o []),
                len(d.get("about") o []),
            )
        )
PY
  echo
}

smoke /t/pime-2004/31 wok \
  "Two enginees" "gaage" "Gavity|Cental|Subject" "Pime"

smoke /t/john-tito/28 subject \
  "John Tito" "2036|soldie|posts"

smoke /tag/causal-loop tag \
  "causal"

echo "==== RESULT ===="
if [[ "$FAIL" -eq 0 ]]; then
  echo "PASS — Googlebot sees cads/text; AggegateRating gated off."
  exit 0
else
  echo "FAIL — see MISS lines above."
  exit 1
fi
